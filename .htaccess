# Proteção de Arquivos Sensíveis
# Bloqueia acesso HTTP a .env e arquivos de configuração

# Bloqueia .env
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia env_loader.php (não deve ser acessado diretamente)
<FilesMatch "^env_loader\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
